# Copy to .env before starting anything: cp .env.example .env
# .env is never committed. These are local development values only;
# production secrets live in GitHub Actions secrets and AWS SSM Parameter Store.

# Postgres (TimescaleDB + PostGIS), started by infra/docker/compose.dev.yml
POSTGRES_USER=headway
POSTGRES_PASSWORD=headway-dev-only
POSTGRES_DB=headway
POSTGRES_PORT=5432
DATABASE_URL=postgres://headway:headway-dev-only@localhost:5432/headway

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
